{
	"name": "anvia-final-assignment",
	"private": true,
	"scripts": {
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"dev": "dotenv -e .env -- concurrently --kill-others-on-fail --names agents,platform,api,worker \"pnpm --filter @repo/agents dev\" \"pnpm --filter @repo/platform dev\" \"pnpm --filter @repo/api dev\" \"pnpm --filter @repo/api worker:dev\"",
		"dev:platform": "dotenv -e .env -- pnpm --filter @repo/platform dev",
		"dev:api": "dotenv -e .env -- pnpm --filter @repo/api dev",
		"worker:dev": "dotenv -e .env -- pnpm --filter @repo/api worker:dev",
		"build": "dotenv -e .env -- pnpm -r --if-present build",
		"typecheck": "dotenv -e .env -- pnpm -r --if-present typecheck",
		"db:generate": "dotenv -e .env -- pnpm --filter @repo/api prisma:generate",
		"db:migrate": "dotenv -e .env -- pnpm --filter @repo/api prisma:migrate",
		"db:deploy": "dotenv -e .env -- pnpm --filter @repo/api prisma:deploy",
		"db:studio": "dotenv -e .env -- pnpm --filter @repo/api prisma:studio",
		"ingest:handbook": "pnpm --filter @repo/agents ingest:handbook",
		"eval": "dotenv -e .env -- pnpm --filter @repo/agents eval",
		"studio": "dotenv -e .env -- pnpm --filter @repo/agents studio"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"concurrently": "^9.2.1",
		"dotenv-cli": "^11.0.0"
	},
	"packageManager": "pnpm@11.9.0"
}
